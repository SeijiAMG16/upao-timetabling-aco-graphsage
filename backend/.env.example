# Backend Environment Variables
# Digital Ocean App Platform

# Database Configuration
# Para DigitalOcean Managed MySQL, usa: mysql+pymysql://user:pass@host:port/db?ssl-mode=REQUIRED
DATABASE_URL=mysql+pymysql://usuario:password@host:puerto/database?charset=utf8mb4

# Security
SECRET_KEY=your-secret-key-here-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=production

# CORS Origins (separados por comas)
CORS_ORIGINS=https://tu-frontend.herokuapp.com,https://tu-backend.ondigitalocean.app

# Frontend URL para redirecciones
FRONTEND_URL=https://tu-frontend.herokuapp.com
